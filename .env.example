# Copy to .env for local development. Never commit .env.

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=analyzer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application roles. These are created by migration 0002 and are NOT superusers,
# which is what makes row-level security actually bind. See docs/DECISIONS.md.
APP_RW_PASSWORD=app_rw_dev_password
APP_RO_PASSWORD=app_ro_dev_password
APP_AUTH_PASSWORD=app_auth_dev_password

# Runtime connection (non-superuser, RLS-enforced).
DATABASE_URL=postgresql+psycopg://app_rw:app_rw_dev_password@db:5432/analyzer
# Migrations and test setup only (schema owner).
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:postgres@db:5432/analyzer
# Phase 5 text-to-SQL: SELECT-only.
DATABASE_RO_URL=postgresql+psycopg://app_ro:app_ro_dev_password@db:5432/analyzer
# Credential lookup only (BYPASSRLS on app_user, SELECT-only).
DATABASE_AUTH_URL=postgresql+psycopg://app_auth:app_auth_dev_password@db:5432/analyzer

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (MinIO locally, S3-compatible in prod) ------------------
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=ap-south-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-in-every-environment
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- App --------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
