# Copy to .env for local development. Never commit .env.
#
# Every value marked __GENERATE__ must be replaced before this file is usable.
# There are deliberately no working defaults: this file is public, so any
# default in it is a published credential, and a published credential that
# happens to work is one deployment away from being a breach.
#
# Generate them all at once:
#
#   python - <<'PY'
#   import secrets
#   for k in ("APP_RW_PASSWORD","APP_RO_PASSWORD","APP_AUTH_PASSWORD",
#             "POSTGRES_PASSWORD","S3_SECRET_ACCESS_KEY","JWT_SECRET"):
#       print(f"{k}={secrets.token_urlsafe(32)}")
#   PY
#
# Then paste the values in below, and into the DATABASE_* URLs, which embed
# the same passwords.

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=analyzer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application roles. These are created by migration 0002 and are NOT superusers,
# which is what makes row-level security actually bind. See docs/DECISIONS.md.
# Migration 0002 has no fallback for these: if they are unset it refuses to run
# rather than creating a role whose password is in a public repository.
APP_RW_PASSWORD=__GENERATE__
APP_RO_PASSWORD=__GENERATE__
APP_AUTH_PASSWORD=__GENERATE__

# Runtime connection (non-superuser, RLS-enforced).
DATABASE_URL=postgresql+psycopg://app_rw:__GENERATE__@db:5432/analyzer
# Migrations and test setup only (schema owner).
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:__GENERATE__@db:5432/analyzer
# Phase 5 text-to-SQL: SELECT-only.
DATABASE_RO_URL=postgresql+psycopg://app_ro:__GENERATE__@db:5432/analyzer
# Credential lookup only (BYPASSRLS on app_user, SELECT-only).
DATABASE_AUTH_URL=postgresql+psycopg://app_auth:__GENERATE__@db:5432/analyzer

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (MinIO locally, S3-compatible in prod) ------------------
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=ap-south-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=__GENERATE__
S3_SECRET_ACCESS_KEY=__GENERATE__
S3_FORCE_PATH_STYLE=true

# --- Auth -------------------------------------------------------------------
# A known JWT signing secret means anyone can mint a valid session token.
JWT_SECRET=__GENERATE__
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- App --------------------------------------------------------------------
# Outside "local" and "test", api.settings refuses to start if any secret above
# is still a placeholder, a known weak value, or shorter than 24 characters.
ENVIRONMENT=local
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
